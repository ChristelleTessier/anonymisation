{
  "categories": ["SECRET", "DONNEES_PERSONNELLES", "DB_CONNECTION", "INFOS_RESEAU", "URL_API", "METADATA_PATHS"],
  "def_rules": [
    {
      "categorie": "SECRET",
      "pattern": "(?i)(api_key|client_secret|auth_token|password|passwd|access_token|secret)\\s*[:=]\\s*[\"'][^\"']+[\"']",
      "description": "Détection des secrets (Clés API, JWT, Clés Privées). "
    },
    {
      "categorie": "SECRET",
      "pattern": "-----BEGIN [A-Z ]+ PRIVATE KEY-----",
      "description": "Détection des secrets (Clés API, JWT, Clés Privées)."
    },
    {
      "categorie": "SECRET",
      "pattern": "(?:eyJ|eyJ).{50,}\\.eyJ|eyJ",
      "description": "Détection des secrets (Clés API, JWT, Clés Privées)."
    },
    {
      "categorie": "DONNEES_PERSONNELLES",
      "pattern": "\\b[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Z|a-z]{2,}\\b",
      "description": "Données personnelles (Email, Tel, Dates)."
    },
    {
      "categorie": "DONNEES_PERSONNELLES",
      "pattern": "\\b(?:\\+?\\d{1,3}[-.\\s]?)?\\(?\\d{3}\\)?[-.\\s]?\\d{3}[-.\\s]?\\d{4}\\b",
      "description": "Données personnelles (Email, Tel, Dates)."
    },
    {
      "categorie": "DONNEES_PERSONNELLES",
      "pattern": "\\d{2}/\\d{2}/\\d{4}|\\d{4}-\\d{2}-\\d{2}",
      "description": "Données personnelles (Email, Tel, Dates)."
    },
    {
      "categorie": "DB_CONNECTION",
      "pattern": "jdbc:[a-z]+://[^\\s\"']+",
      "description": "Information connexion BDD (chemin de connection et variables de configuration."
    },
    {
      "categorie": "DB_CONNECTION",
      "pattern": "(?i)(db_user|db_password|database_url)\\s*[:=]\\s*[\"'][^\"']+[\"']",
      "description": "Information connexion BDD (chemin de connection et variables de configuration."
    },
    {
      "categorie": "INFOS_RESEAU",
      "pattern": "\\b(?:\\d{1,3}\\.){3}\\d{1,3}\\b",
      "description": "Information sur la structure du reseau."
    },
    {
      "categorie": "INFOS_RESEAU",
      "pattern": "[a-zA-Z0-9.-]+\\.(?:internal|local|lan|corp|priv)",
      "description": "Information sur la structure du reseau."
    },
    {
      "categorie": "INFOS_RESEAU",
      "pattern": "[a-z0-9.-]+\\.s3\\.amazonaws\\.com",
      "description": "Information sur la structure du reseau."
    },
    {
      "categorie": "URL_API",
      "pattern": "https?://[a-zA-Z0-9.-]+(?:/[a-zA-Z0-9._\\-/]*)?",
      "description": "lien url de connection vers API."
    },
    {
      "categorie": "METADATA_PATHS",
      "pattern": "(?:/home/|/Users/|C:\\\\Users\\\\)[a-zA-Z0-9._\\\\-\\\\ ]+",
      "description": "Chemin absolu des fichiers locaux."
    }
  ]
}